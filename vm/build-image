#!/usr/bin/bash

set -euo pipefail

scriptloc=$(realpath "$(dirname "$0")")
echo "${scriptloc}"
distro="$1"
config="$2"
outputdir=/scratch/VMs/

pushd ../image-builder
go build -o ./bin/image-builder ./cmd/image-builder
popd

sudo -E ../image-builder/bin/image-builder \
    build \
    --distro "$distro" \
    --rpmmd-cache /scratch/rpmmd \
    --cache /scratch/osbuild-store \
    --force-repo-dir ./repositories \
    --output-dir "$outputdir" \
    --blueprint "${config}" \
    qcow2
